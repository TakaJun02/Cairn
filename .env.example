# =============================================================================
#  guidanceLLM2 — 環境変数のひな形
# =============================================================================
#  使い方: cp .env.example .env して値を埋める。.env は Git 追跡外（NFR-6）。
#
#  ★ 正はコードである。ここに載っているキーは backend/app/core/config.py の
#    Settings と 1 対 1 に対応させること（Docs/20_architecture.md §11）。
#    Settings に無いキーをここに残さない／ここに無いキーをコードで読まない。
#
#  ★ 大文字小文字: pydantic-settings は既定で case-insensitive なので、
#    旧 .env の `Inference_server` のような表記もそのまま読める。
#    ただし新規に足すキーは UPPER_SNAKE_CASE に揃える（旧構成の同義キー乱立を繰り返さない。
#    Docs/22_current_issues.md §8-2）。
# =============================================================================

# --- データベース（PostgreSQL 1 台。PostGIS + pgvector）----------------------
#  イメージは docker/postgres/Dockerfile でビルドする（Docs/50_operations/database.md）。
#  app は host network で動くため、公開済みのホスト側ポートへ接続する
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=guidance
POSTGRES_USER=guidance
POSTGRES_PASSWORD=

# --- 経路探索（OSRM）--------------------------------------------------------
#  データの作り方は Docs/50_operations/osrm.md。app は host network で動くため、
#  OSRM コンテナをホストへ公開した 5001（car）/ 5002（foot）へ接続する
OSRM_CAR_URL=http://127.0.0.1:5001
OSRM_FOOT_URL=http://127.0.0.1:5002
OSRM_CONCURRENCY=8
OSRM_REQUEST_TIMEOUT_SEC=5
OSRM_REQUEST_RETRIES=2
OSRM_RETRY_BACKOFF_SEC=0.5
OSRM_LEG_TIMEOUT_SEC=20
OSRM_TABLE_TIMEOUT_SEC=60
OSRM_TABLE_RETRIES=1

# --- ジオ派生データ・沿道判定 ---------------------------------------------
GEO_CAR_SNAP_TOLERANCE_M=50
GEO_ACCESS_CANDIDATE_COUNT=5
GEO_ALONG_CAR_BUFFER_M=300
GEO_ALONG_FOOT_BUFFER_M=50
GEO_FOOT_MAX_DURATION_SEC=1800
GEO_FOOT_MAX_DISTANCE_M=2500
#  小数6桁は緯度経度でおよそ0.1 m。冪等キーと成果物サイズを安定させる
GEO_COORDINATE_PRECISION=6
GEO_GEOJSON_PRECISION=6

# --- 生成 LLM（ホスト GPU 上の vLLM。OpenAI 互換 /v1）-----------------------
#  vLLM はホストの loopback のみに bind されるため、app も host network で接続する
INFERENCE_SERVER=http://127.0.0.1:8000/v1
INFERENCE_MODEL=
INFERENCE_TIMEOUT_SEC=120
# token が出ない区間に SSE コメントを送る間隔
CHAT_SSE_HEARTBEAT_SEC=15
# false なら決定的スコア順だけで返す（LLM 障害時と同じ縮退経路）
RECOMMENDATION_RERANK_ENABLED=true

# --- 埋め込み（別マシンの vLLM。知識検索でのみ使う）------------------------
#  Docs/adr/0012-knowledge-retrieval-pgvector.md。落ちていても字句検索に縮退する
EMBEDDING_SERVER=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096
EMBEDDING_TIMEOUT_SEC=120

# --- Web 検索（Tavily。知識検索サブエージェントの 4 つ目の Tool）-----------
#  未設定なら web_search は「利用不可」の観測を返す（NFR-5 の縮退）
TAVILY_API_KEY=

# --- パック成果物 -----------------------------------------------------------
#  compose では named volume `packs_data` をここにマウントする
#  （ホスト固有パスを compose から排除する。Docs/22_current_issues.md §8-4）
PACKS_ROOT=/packs

# --- リアルタイム / LoRaWAN（TTN）------------------------------------------
#  Docs/30_design/realtime_lora.md。未設定なら MQTT を起動しない（対話には影響しない）
RT_MQTT_BROKER=au1.cloud.thethings.network
RT_MQTT_PORT=8883
RT_MQTT_USER=
RT_MQTT_PASS=
TTN_APP_ID=
TTN_DEVICE_ID=

# --- アプリ -----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
#  開発時のみ。本番は同一オリジン配信を想定する（Docs/40_api/chat_sse.md §5.3）
CORS_ALLOW_ORIGINS=http://localhost:5173
