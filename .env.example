# =============================================================================
#  guidanceLLM2 — 環境変数のひな形
# =============================================================================
#  使い方: cp .env.example .env して値を埋める。.env は Git 追跡外（NFR-6）。
#
#  ★ .env に置くのは 2 種類だけ（Docs/20_architecture.md §11）
#      1. 秘密       — API キー、パスワード、MQTT の資格情報
#      2. 環境固有値 — IP アドレスやそれを含む URL、モデル名など、
#                      「人によって値が変わる」もの
#
#  ★ それ以外はここに書かない
#      - チューニング値（OSRM_* / GEO_* / タイムアウト / 各種フラグ）
#          → backend/app/core/config.py の Settings が既定値を持つ。
#            変えたいときだけ .env に足せば上書きできる（キー名は Settings が正）
#      - 接続先のトポロジ（POSTGRES_HOST / OSRM_*_URL / PACKS_ROOT など）
#          → docker-compose.yml の environment: が決める。
#            compose で立てる限り .env に書く必要はない
#
#  ★ キー名は大文字小文字を区別しない（pydantic-settings）が、UPPER_SNAKE_CASE に揃える
# =============================================================================


# =============================================================================
#  必須
# =============================================================================

# --- PostgreSQL -------------------------------------------------------------
#  未設定だと compose がエラーで止まる（空パスワードでの初期化失敗を防ぐため）。
#
#  DB 名 / ユーザー名はここで扱わない。どちらも秘密ではなく環境でも変わらず、
#  pgdata の初期化時に焼き付いて後から変えられないので、プロジェクトの定数として
#  docker-compose.yml と config.py の既定値に guidance を固定してある
POSTGRES_PASSWORD=

# --- 生成 LLM（vLLM / OpenAI 互換 API）--------------------------------------
#  ホストの GPU 上で動かす想定。app は host network なので loopback に届く。
#  別マシンの vLLM を使うならそのアドレスに変える
INFERENCE_SERVER=http://127.0.0.1:8000/v1
#  vLLM が --served-model-name で公開している名前をそのまま書く
INFERENCE_MODEL=


# =============================================================================
#  任意（使う機能がある場合だけ設定する。未設定でも起動する）
# =============================================================================

# --- 埋め込み（別マシンの vLLM。知識検索のベクトル化にのみ使う）-------------
#  Docs/adr/0012-knowledge-retrieval-pgvector.md。
#  未設定・接続不能なら字句検索へ縮退する（NFR-5）
EMBEDDING_SERVER=
#  既定は Qwen/Qwen3-Embedding-8B。DB の vector(4096) と次元が一致する
#  モデルでなければならない（不一致は起動時に検出して落とす）
# EMBEDDING_MODEL=

# --- Web 検索（Tavily。知識検索サブエージェントの 4 つ目の Tool）-----------
#  未設定なら web_search は「利用不可」の観測を返す（NFR-5 の縮退）
TAVILY_API_KEY=

# --- LoRaWAN / TTN（実機検証時のみ）-----------------------------------------
#  Docs/30_design/realtime_lora.md。RT_MQTT_ENABLED=true かつ下の 4 つが
#  すべて埋まっているときだけ MQTT に接続する。対話機能には影響しない
RT_MQTT_ENABLED=false
RT_MQTT_USER=
RT_MQTT_PASS=
TTN_APP_ID=
TTN_DEVICE_ID=
#  ブローカは既定 au1.cloud.thethings.network:8883。別リージョンのときだけ設定する
# RT_MQTT_BROKER=
# RT_MQTT_PORT=

# --- 開発時の上書き（compose の既定で足りないときだけ）----------------------
#  フロントを localhost 以外（例: 開発機の LAN アドレス）から開く場合は、
#  そのオリジンを CORS に足す。カンマ区切り
# CORS_ALLOW_ORIGINS=http://localhost:5173
#  フロントが API を叩く先。未設定なら Vite の proxy 経由（/api/v1）になる
# VITE_API_BASE=
# APP_ENV=development
# LOG_LEVEL=INFO
