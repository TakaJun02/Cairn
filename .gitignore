/packs/

.env*
!.env.example

# OSRM の地図データ（scripts/build_osrm.sh で作る。ADR-0014）
# BUILD だけは追跡する — 「今のリポジトリが想定している地図データはどれか」を残すため
# ディレクトリごと除外すると中の BUILD を再包含できない（git の仕様）ので /* にする
backend/data/map/*
!backend/data/map/BUILD

# Node
node_modules/
dist/
plugins/lorart/node_modules/
plugins/lorart/dist/

